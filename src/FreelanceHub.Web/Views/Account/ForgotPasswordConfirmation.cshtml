@{
    ViewData["Title"] = "Check your email";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <h1 class="h3 mb-3">Check your email</h1>
                <p class="text-muted">If an account exists for that email, a password reset link has been sent.</p>
                <a asp-action="Login" class="btn btn-primary">Back to login</a>
            </div>
        </div>
    </div>
</div>
