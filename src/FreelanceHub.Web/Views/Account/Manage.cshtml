@model AccountSettingsViewModel

@{
    ViewData["Title"] = "Account Settings";
}

<div class="row justify-content-center py-4">
    <div class="col-xl-10">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
            <div>
                <h1 class="h2 mb-2">Account settings</h1>
                <p class="text-muted mb-0">Manage the details used to identify and secure your account.</p>
            </div>
            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">Back to profile</a>
        </div>

        @if (TempData["AccountSettingsSuccess"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }

        <div class="row g-4">
            <div class="col-lg-7">
                <section class="card h-100 shadow-sm border-0">
                    <div class="card-body p-4 p-lg-5">
                        <h2 class="h4 mb-2">Account details</h2>
                        <p class="text-muted mb-4">Your username is permanent. Changing your email requires your current password.</p>

                        <form asp-action="UpdateAccountDetails" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label class="form-label">Username</label>
                                <input value="@Model.AccountDetails.Username" class="form-control" readonly />
                                <div class="form-text">Usernames cannot be changed.</div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="AccountDetails.FirstName" class="form-label"></label>
                                    <input asp-for="AccountDetails.FirstName" class="form-control" autocomplete="given-name" />
                                    <span asp-validation-for="AccountDetails.FirstName" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="AccountDetails.LastName" class="form-label"></label>
                                    <input asp-for="AccountDetails.LastName" class="form-control" autocomplete="family-name" />
                                    <span asp-validation-for="AccountDetails.LastName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center gap-3">
                                    <label asp-for="AccountDetails.Email" class="form-label"></label>
                                    @if (Model.AccountDetails.IsEmailConfirmed)
                                    {
                                        <span class="badge text-bg-success">Verified</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Unverified</span>
                                    }
                                </div>
                                <input asp-for="AccountDetails.Email" class="form-control" autocomplete="email" />
                                <span asp-validation-for="AccountDetails.Email" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="AccountDetails.CurrentPassword" class="form-label"></label>
                                <input asp-for="AccountDetails.CurrentPassword" class="form-control" autocomplete="current-password" />
                                <div class="form-text">Required only when changing your email address.</div>
                                <span asp-validation-for="AccountDetails.CurrentPassword" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary">Save account details</button>
                        </form>
                    </div>
                </section>
            </div>

            <div class="col-lg-5">
                <section class="card h-100 shadow-sm border-0">
                    <div class="card-body p-4 p-lg-5">
                        <h2 class="h4 mb-2">Change password</h2>
                        <p class="text-muted mb-4">Use your current password to choose a new one.</p>

                        <form asp-action="ChangePassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="Password.CurrentPassword" class="form-label"></label>
                                <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                                <span asp-validation-for="Password.CurrentPassword" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password.NewPassword" class="form-label"></label>
                                <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Password.NewPassword" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Password.ConfirmNewPassword" class="form-label"></label>
                                <input asp-for="Password.ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Password.ConfirmNewPassword" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-dark">Change password</button>
                        </form>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
