@{
    ViewData["Title"] = "Register";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="auth-shell">
    <div class="auth-intro">
        <span class="auth-kicker">Join FreelanceHub</span>
        <h1>Choose your<br /><em>way to work.</em></h1>
        <p>Start with the account that matches what you want to accomplish.</p>
    </div>

    <div class="auth-panel auth-choice-panel">
        <header class="auth-panel-heading">
            <span>Account type</span>
            <h2>How will you use FreelanceHub?</h2>
        </header>

        <div class="auth-choice-list">
            <a asp-action="RegisterClient" asp-route-returnUrl="@returnUrl" class="auth-choice">
                <span class="auth-choice-number">01</span>
                <div>
                    <h3>Hire professionals</h3>
                    <p>Publish projects, review proposals, and work with freelancers.</p>
                </div>
                <span class="auth-choice-arrow" aria-hidden="true">&rarr;</span>
            </a>

            <a asp-action="RegisterFreelancer" asp-route-returnUrl="@returnUrl" class="auth-choice">
                <span class="auth-choice-number">02</span>
                <div>
                    <h3>Find freelance work</h3>
                    <p>Showcase your expertise, discover projects, and submit proposals.</p>
                </div>
                <span class="auth-choice-arrow" aria-hidden="true">&rarr;</span>
            </a>
        </div>

        <p class="auth-panel-footer">
            Already registered? <a asp-action="Login" asp-route-returnUrl="@returnUrl">Login</a>
        </p>
    </div>
</section>
