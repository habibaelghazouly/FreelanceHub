@model RegisterClientViewModel

@{
    ViewData["Title"] = "Create Client Account";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="auth-shell">
    <div class="auth-intro">
        <span class="auth-kicker">Client account</span>
        <h1>Build your<br /><em>next team.</em></h1>
        <p>Tell us who is hiring, then start posting projects and reviewing proposals.</p>
    </div>

    <div class="auth-panel">
        <header class="auth-panel-heading">
            <span>Create an account</span>
            <h2>Client details</h2>
            <p>Set up your identity and hiring profile.</p>
        </header>

        <form asp-action="RegisterClient" asp-route-returnUrl="@returnUrl" method="post" enctype="multipart/form-data" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <partial name="_RegisterAccountFields" model="Model" />

            <section class="auth-form-section">
                <h3>Hiring profile</h3>

                <div class="mb-3">
                    <label asp-for="ClientType" class="form-label"></label>
                    <select asp-for="ClientType" asp-items="Html.GetEnumSelectList<ClientType>()" class="form-select">
                        <option value="">Select client type</option>
                    </select>
                    <span asp-validation-for="ClientType" class="text-danger"></span>
                </div>

                <div id="companyFields">
                    <div class="mb-3">
                        <label asp-for="CompanyName" class="form-label"></label>
                        <input asp-for="CompanyName" class="form-control" />
                        <span asp-validation-for="CompanyName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CompanyWebsite" class="form-label"></label>
                        <input asp-for="CompanyWebsite" class="form-control" type="url" placeholder="https://example.com" />
                        <span asp-validation-for="CompanyWebsite" class="text-danger"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="CompanyDescription" class="form-label"></label>
                        <textarea asp-for="CompanyDescription" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="CompanyDescription" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <button type="submit" class="auth-submit">Create Client account</button>
        </form>

        <p class="auth-panel-footer">
            <a asp-action="Register" asp-route-returnUrl="@returnUrl">Choose a different account type</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const clientType = document.getElementById('ClientType');
            const companyFields = document.getElementById('companyFields');
            const companyName = document.getElementById('CompanyName');
            const companyDescription = document.getElementById('CompanyDescription');

            function syncCompanyFields() {
                const isCompany = clientType.value === '@((int)ClientType.Company)';
                companyFields.classList.toggle('d-none', !isCompany);
                companyFields.querySelectorAll('input, textarea').forEach(field => field.disabled = !isCompany);
                companyName.required = isCompany;
                companyDescription.required = isCompany;
            }

            clientType.addEventListener('change', syncCompanyFields);
            syncCompanyFields();
        })();
    </script>
}
