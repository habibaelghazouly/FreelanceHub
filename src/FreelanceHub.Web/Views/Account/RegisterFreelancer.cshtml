@model RegisterFreelancerViewModel

@{
    ViewData["Title"] = "Create Freelancer Account";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h3 mb-2">Create a Freelancer account</h1>
                <p class="text-muted mb-4">Add the essentials clients need when reviewing your profile.</p>

                <form asp-action="RegisterFreelancer" asp-route-returnUrl="@returnUrl" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <partial name="_RegisterAccountFields" model="Model" />

                    <div class="border rounded p-3 mb-3">
                        <h2 class="h6 mb-3">Professional details</h2>

                        <div class="mb-3">
                            <label asp-for="ProfessionalTitle" class="form-label"></label>
                            <input asp-for="ProfessionalTitle" class="form-control" placeholder="e.g. Backend .NET Developer" />
                            <span asp-validation-for="ProfessionalTitle" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="HourlyRate" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="HourlyRate" class="form-control" step="0.01" />
                                </div>
                                <span asp-validation-for="HourlyRate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ExperienceLevel" class="form-label"></label>
                                <select asp-for="ExperienceLevel" asp-items="Html.GetEnumSelectList<FreelancerExperienceLevel>()" class="form-select">
                                    <option value="">Select level</option>
                                </select>
                                <span asp-validation-for="ExperienceLevel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AvailabilityStatus" class="form-label"></label>
                            <select asp-for="AvailabilityStatus" asp-items="Html.GetEnumSelectList<FreelancerAvailabilityStatus>()" class="form-select">
                                <option value="">Select status</option>
                            </select>
                            <span asp-validation-for="AvailabilityStatus" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ExternalPortfolioUrl" class="form-label"></label>
                            <input asp-for="ExternalPortfolioUrl" class="form-control" type="url" placeholder="https://portfolio.example.com" />
                            <span asp-validation-for="ExternalPortfolioUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Bio" class="form-label"></label>
                            <textarea asp-for="Bio" class="form-control" rows="5" placeholder="Describe your expertise, experience, and the work you do best."></textarea>
                            <div class="form-text">20 to 2000 characters.</div>
                            <span asp-validation-for="Bio" class="text-danger"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Create Freelancer account</button>
                </form>

                <p class="mt-3 mb-0 text-center">
                    <a asp-action="Register" asp-route-returnUrl="@returnUrl">Choose a different account type</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
