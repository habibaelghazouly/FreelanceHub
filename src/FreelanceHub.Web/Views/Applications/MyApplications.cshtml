@using FreelanceHub.Domain.Enums
@model FreelancerApplicationDashboardViewModel

@{
    ViewData["Title"] = "My Applications";

    static string FormatStatus(ApplicationStatus status) => status switch
    {
        ApplicationStatus.UnderReview => "Under Review",
        _ => status.ToString()
    };
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Applications</h2>
            <p class="text-muted mb-0">Track and manage your submitted job proposals</p>
        </div>

    </div>

    <!-- Success Message Alert -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Applications Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-light py-3 border-bottom-0">
            <h5 class="fw-bold mb-0 text-dark">Application Status Tracking</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Applications == null || Model.Applications.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted display-4 mb-3 d-block"></i>
                    <h5 class="fw-bold">No Applications Yet</h5>
                    <p class="text-muted mb-0">You haven't submitted any job proposals so far.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4">Job</th>
                                <th scope="col">Bid</th>
                                <th scope="col">Timeline</th>
                                <th scope="col">Status</th>
                                <th scope="col">Portfolio</th>
                                <th scope="col">Submitted</th>
                                <th scope="col" class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var application in Model.Applications)
                            {
                                <tr>
                                    <!-- Job Title -->
                                    <td class="ps-4 fw-semibold text-dark">
                                        @application.JobTitle <span class="text-muted small">(#@application.JobId)</span>
                                    </td>

                                    <!-- Bid Amount -->
                                    <td class="fw-semibold text-success">
                                        @application.ProposedAmount.ToString("C")
                                    </td>

                                    <!-- Timeline -->
                                    <td>
                                        @application.TimelineDays days
                                    </td>

                                    <!-- Status Badge -->
                                    <td>
                                        @switch (application.ApplicationStatus)
                                        {
                                            case ApplicationStatus.Accepted:
                                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-medium">Accepted</span>
                                                break;
                                            case ApplicationStatus.Rejected:
                                                <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-medium">Rejected</span>
                                                break;
                                            case ApplicationStatus.UnderReview:
                                                <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-2 rounded-pill fw-medium">Under Review</span>
                                                break;
                                            case ApplicationStatus.Submitted:
                                                <span class="badge bg-info-subtle text-info px-3 py-2 rounded-pill fw-medium">Submitted</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill fw-medium">@FormatStatus(application.ApplicationStatus)</span>
                                                break;
                                        }
                                    </td>

                                    <!-- Portfolio Count -->
                                    <td>
                                        <i class="bi bi-paperclip me-1 text-muted"></i>@application.PortfolioItemCount file(s)
                                    </td>

                                    <!-- Submission Date -->
                                    <td class="text-muted small">
                                        @application.SubmittedAt.ToLocalTime().ToString("g")
                                    </td>

                                    <!-- Action Buttons -->
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">
                                            <!-- View Details Button -->
                                            <a asp-controller="Applications"
                                               asp-action="Details"
                                               asp-route-id="@application.ApplicationId"
                                               class="btn btn-sm btn-outline-primary rounded-3 px-3 d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-eye"></i> Details
                                            </a>


                                            <!-- Open Chat Button -->
                                            <a asp-controller="Chat"
                                               asp-action="Thread"
                                               asp-route-applicationId="@application.ApplicationId"
                                               class="btn btn-sm btn-outline-secondary rounded-3 px-3 d-inline-flex align-items-center gap-1">
                                                 Chat
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>