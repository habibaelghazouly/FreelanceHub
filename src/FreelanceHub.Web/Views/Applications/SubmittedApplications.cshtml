@using FreelanceHub.Domain.Models
@model FreelanceHub.Web.ViewModels.SubmittedApplicationsListViewModel

@{
    ViewData["Title"] = $"Applications for {Model.JobTitle ?? "Job"}";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Submitted Applications</h2>
            <p class="text-muted mb-0">
                Reviewing applications for <strong class="text-dark">@(Model.JobTitle ?? $"Job #{Model.JobId}")</strong>
            </p>
        </div>
        <a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Jobs
        </a>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Applications Content -->
    @if (Model.Applications == null || !Model.Applications.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body">
                <i class="bi bi-inbox text-muted display-4 mb-3 d-block"></i>
                <h5 class="fw-bold">No Applications Yet</h5>
                <p class="text-muted mb-0">There are currently no proposals submitted for this job.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Freelancer</th>
                            <th scope="col">Proposal</th>
                            <th scope="col">Timeline</th>
                            <th scope="col">Current Status</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Applications)
                        {
                            <tr>
                                <!-- Freelancer Info -->
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@(item.FreelancerName ?? "Freelancer")</div>
                                    <small class="text-muted">Applied @item.SubmittedAt.ToString("MMM dd, yyyy")</small>
                                </td>

                                <!-- Proposed Amount -->
                                <td>
                                    <span class="fw-semibold text-success">$@item.ProposedAmount.ToString("N2")</span>
                                </td>

                                <!-- Timeline -->
                                <td>
                                    <span>@item.TimelineDays Days</span>
                                </td>

                                <!-- Current Status Badge -->
                                <td>
                                    @switch (item.ApplicationStatus)
                                    {
                                        case ApplicationStatus.Accepted:
                                            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-medium">Accepted</span>
                                            break;
                                        case ApplicationStatus.Rejected:
                                            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-medium">Rejected</span>
                                            break;
                                        case ApplicationStatus.UnderReview:
                                            <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-2 rounded-pill fw-medium">Under Review</span>
                                            break;
                                        case ApplicationStatus.Submitted:
                                            <span class="badge bg-info-subtle text-info px-3 py-2 rounded-pill fw-medium">Submitted</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill fw-medium">@item.ApplicationStatus.ToString()</span>
                                            break;
                                    }
                                </td>

                                <!-- Actions Column -->
                                <td class="text-end pe-4">
                                    @if (item.ApplicationStatus == ApplicationStatus.Accepted || item.ApplicationStatus == ApplicationStatus.Rejected)
                                    {
                                        <!-- Hide Buttons once Decision is Made -->
                                        <span class="text-muted small fst-italic">Completed</span>
                                    }
                                    else
                                    {
                                        <!-- Render Buttons only when status is pending / submitted / under review -->
                                        <div class="d-inline-flex gap-2">
                                            <!-- Accept Button Form -->
                                            <form asp-controller="Applications" asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="applicationId" value="@item.ApplicationId" />
                                                <input type="hidden" name="applicationStatus" value="@ApplicationStatus.Accepted" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-3 px-3 d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-check-lg"></i> Accept
                                                </button>
                                            </form>

                                            <!-- Reject Button Form -->
                                            <form asp-controller="Applications" asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="applicationId" value="@item.ApplicationId" />
                                                <input type="hidden" name="applicationStatus" value="@ApplicationStatus.Rejected" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-3 d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-x-lg"></i> Reject
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>