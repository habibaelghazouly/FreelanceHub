@model ClientApplicationDashboardViewModel

@{
    ViewData["Title"] = "Submitted Applications";

    static string FormatStatus(FreelanceHub.Domain.Enums.ApplicationStatus status) => status switch
    {
        FreelanceHub.Domain.Enums.ApplicationStatus.UnderReview => "Under Review",
        _ => status.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Submitted Applications @(Model.JobId.HasValue ? $"for Job #{Model.JobId}" : "")</h1>
    @if (Model.JobId.HasValue)
    {
        <a asp-action="SubmittedApplications" class="btn btn-outline-secondary">Show All Applications</a>
    }
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row g-4">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                Application Status Tracking
            </div>
            <div class="card-body p-0">
                @if (Model.Applications.Count == 0)
                {
                    <p class="p-3 mb-0">No applications found.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Job</th>
                                    <th>Freelancer</th>
                                    <th>Bid Amount</th>
                                    <th>Timeline</th>
                                    <th>Status</th>
                                    <th>Submitted</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var application in Model.Applications)
                                {
                                    <tr>
                                        <td>@application.JobTitle (#@application.JobId)</td>
                                        <td>@application.FreelancerDisplayName (#@application.FreelancerUserId)</td>
                                        <td>@application.ProposedAmount.ToString("C")</td>
                                        <td>@application.TimelineDays days</td>
                                        <td>@FormatStatus(application.ApplicationStatus)</td>
                                        <td>@application.SubmittedAt.ToLocalTime().ToString("g")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>