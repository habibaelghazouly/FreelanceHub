@model IEnumerable<FreelanceHub.Application.DTOs.Results.ContractListResult>

@{
    ViewData["Title"] = "Contracts";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Contracts</h2>
            <p class="text-muted mb-0">Manage all active and completed contracts.</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No contracts found.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Job</th>
                            @if (User.IsInRole("Client"))
                            {
                                <th>Freelancer</th>
                            }
                            else if (User.IsInRole("Freelancer"))
                            {
                                <th>Client</th>
                            }
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Start Date</th>
                            <th>Expected End</th>
                            <th>Completed</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var contract in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @contract.JobTitle
                                    </div>

                                    <small class="text-muted">
                                        @(contract.JobDescription.Length > 70
                                            ? contract.JobDescription.Substring(0, 70) + "..."
                                            : contract.JobDescription)
                                    </small>
                                </td>
                                @if (User.IsInRole("Client"))
                                {
                                    <td>
                                        <a asp-controller="Profile" asp-action="Index" asp-route-id="@contract.FreelancerUserId"
                                           class="fw-semibold text-decoration-none">
                                            @contract.FreelancerDisplayName
                                        </a>
                                    </td>
                                }
                                else if (User.IsInRole("Freelancer"))
                                {

                                    <td>
                                       <a asp-controller="Profile" asp-action="Index" asp-route-id="@contract.ClientUserId"
                                           class="fw-semibold text-decoration-none">
                                            @contract.ClientDisplayName
                                        </a>
                                    </td>
                                }

                                <td class="fw-bold text-success">
                                    @contract.AgreedAmount.ToString("C")
                                </td>

                                <td>
                                    @{
                                        var badge = contract.ContractStatus.ToLower() switch
                                        {
                                            "active" => "bg-primary",
                                            "completed" => "bg-success",
                                            "cancelled" => "bg-danger",
                                            "pending" => "bg-warning text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }

                                    <span class="badge @badge">
                                        @contract.ContractStatus
                                    </span>
                                </td>

                                <td>
                                    @contract.StartDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @(contract.ExpectedCompletionDate?.ToString("dd MMM yyyy") ?? "-")
                                </td>

                                <td>
                                    @(contract.ActualCompletionDate?.ToString("dd MMM yyyy") ?? "-")
                                </td>

                                <td class="text-center">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Details" asp-route-id="@contract.ContractId"
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-eye"></i>
                                            Details
                                        </a>
                                        <a asp-controller="Chat" asp-action="Thread"
                                           asp-route-applicationId="@contract.AcceptedApplicationId"
                                           class="btn btn-outline-secondary btn-sm">Chat</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }

</div>
