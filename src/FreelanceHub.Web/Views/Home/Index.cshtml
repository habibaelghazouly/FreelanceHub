@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Manage projects, proposals, and collaborations in one place.</p>
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Freelancer"))
    {
        <a class="btn btn-primary" asp-controller="Applications" asp-action="Submit">Submit Application</a>
    }
</div>
