@model IEnumerable<FreelanceHub.Domain.Models.Job>

@{
    ViewData["Title"] = "My Jobs";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Jobs</h2>

        <a asp-action="Create" class="btn btn-primary">
            Create Job
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You haven't posted any jobs yet.
        </div>
    }
    else
    {
        foreach (var job in Model)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="row">

                        <div class="col-md-9">
                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <h4 class="mb-0">@job.Title</h4>

                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var tag in job.JobTags)
                                    {
                                        <span class="badge bg-info text-dark">
                                            @tag.Tag.Name
                                        </span>
                                    }
                                </div>

                            </div>

                            <p class="text-muted">
                                @(job.Description.Length > 200
                                    ? job.Description.Substring(0, 200) + "..."
                                    : job.Description)
                            </p>
                            <div class="mt-3">

                                @if (job.JobCategories.Any())
                                {
                                    <div class="mb-2">
                                        <strong>Categories</strong><br />

                                        @foreach (var category in job.JobCategories)
                                        {
                                            <span class="badge bg-primary me-1">
                                                @category.Category.Name
                                            </span>
                                        }
                                    </div>
                                }

                            </div>

                            <div class="row">
                                <div class="col-md-3">
                                    <strong>Budget</strong><br />
                                    @job.Budget.ToString("C")
                                </div>

                                <div class="col-md-3">
                                    <strong>Deadline</strong><br />
                                    @job.Deadline.ToShortDateString()
                                </div>

                                <div class="col-md-3">
                                    <strong>Status</strong><br />
                                    <span class="badge bg-success">
                                        @job.JobStatus
                                    </span>
                                </div>
                                 <div class="col-md-3">
                                    <strong>No of Applications</strong><br />
                                    <span class="badge bg-success">
                                        @job.Applications.Count()
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 d-flex align-items-center justify-content-center">
                            <div class="d-grid gap-2" style="width:75%;">

                                <a asp-action="DetailJob" asp-route-id="@job.JobId" class="btn btn-outline-primary">
                                    View
                                </a>

                                <a asp-action="Applications" asp-route-id="@job.JobId" class="btn btn-outline-success">
                                    Applications
                                </a>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    }
</div>