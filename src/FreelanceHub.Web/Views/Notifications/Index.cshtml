@model FreelanceHub.Application.DTOs.Results.NotificationPageResult

@{
    ViewData["Title"] = "Notifications";
}

<div class="notifications-page py-4">
    <div class="notifications-heading">
        <div>
            <h1>Notifications</h1>
            <p>Application, message, contract, and review updates.</p>
        </div>
        <button type="button" class="notification-action" data-mark-all-read>Mark all as read</button>
    </div>

    <nav class="notification-filters" aria-label="Notification filters">
        <a asp-action="Index" class="@(Model.UnreadOnly ? null : "is-active")">All</a>
        <a asp-action="Index" asp-route-unreadOnly="true" class="@(Model.UnreadOnly ? "is-active" : null)">Unread</a>
    </nav>

    @if (Model.Notifications.Count == 0)
    {
        <div class="notification-empty">
            @(Model.UnreadOnly ? "You have no unread notifications." : "You have no notifications yet.")
        </div>
    }
    else
    {
        <div class="notification-page-list">
            @foreach (var notification in Model.Notifications)
            {
                var avatarUrl = string.IsNullOrWhiteSpace(notification.ActorProfileImageUrl)
                    ? Url.Content("~/img/default-avatar.svg")
                    : notification.ActorProfileImageUrl;

                <a href="@notification.TargetUrl"
                   data-notification-link
                   data-notification-id="@notification.NotificationId"
                   class="notification-page-item @(!notification.IsRead ? "is-unread" : null)">
                    <img src="@avatarUrl" alt="" />
                    <span class="notification-page-content">
                        <strong>@notification.Title</strong>
                        <span>@notification.Message</span>
                        <small>
                            @if (!string.IsNullOrWhiteSpace(notification.ActorDisplayName))
                            {
                                <span>@notification.ActorDisplayName · </span>
                            }
                            @notification.CreatedAt.ToLocalTime().ToString("g")
                        </small>
                    </span>
                    @if (!notification.IsRead)
                    {
                        <span class="notification-unread-marker" aria-label="Unread"></span>
                    }
                </a>
            }
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="notification-pagination" aria-label="Notification pages">
            @if (Model.Page > 1)
            {
                <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-unreadOnly="@Model.UnreadOnly">Previous</a>
            }
            <span>Page @Model.Page of @Model.TotalPages</span>
            @if (Model.Page < Model.TotalPages)
            {
                <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-unreadOnly="@Model.UnreadOnly">Next</a>
            }
        </nav>
    }
</div>
