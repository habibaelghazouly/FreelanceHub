@using FreelanceHub.Application.DTOs.Results
@using FreelanceHub.Domain.Enums
@model ProfilePageViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Profile";
    ViewData["MainContainerClass"] = "container-fluid px-3 px-lg-4";
    var profile = Model.Profile;

    var firstInitial = string.IsNullOrWhiteSpace(profile.FirstName) ? string.Empty : profile.FirstName[..1];
    var lastInitial = string.IsNullOrWhiteSpace(profile.LastName) ? string.Empty : profile.LastName[..1];
    var initials = $"{firstInitial}{lastInitial}".ToUpperInvariant();

    var hasCompanyWebsite = Uri.TryCreate(profile.CompanyWebsite, UriKind.Absolute, out var companyWebsiteUri)
        && (companyWebsiteUri.Scheme == Uri.UriSchemeHttp || companyWebsiteUri.Scheme == Uri.UriSchemeHttps);

    var hasPortfolioUrl = Uri.TryCreate(profile.ExternalPortfolioUrl, UriKind.Absolute, out var portfolioUri)
        && (portfolioUri.Scheme == Uri.UriSchemeHttp || portfolioUri.Scheme == Uri.UriSchemeHttps);
    var hasRating = profile.RatingCount > 0;
    var ratingLabel = hasRating ? profile.RatingAverage.ToString("0.0") : "New";
    var availabilityLabel = profile.AvailabilityStatus switch
    {
        FreelancerAvailabilityStatus.Available => "Available",
        FreelancerAvailabilityStatus.Busy => "Busy",
        FreelancerAvailabilityStatus.Unavailable => "Unavailable",
        _ => null
    };
    var availabilityClass = profile.AvailabilityStatus switch
    {
        FreelancerAvailabilityStatus.Available => "is-available",
        FreelancerAvailabilityStatus.Busy => "is-busy",
        FreelancerAvailabilityStatus.Unavailable => "is-unavailable",
        _ => string.Empty
    };
    var isCompanyClient = profile.Role == "Client" && profile.ClientType == ClientType.Company;
    var profileSummary = profile.Role == "Freelancer"
        ? profile.ProfessionalTitle
        : isCompanyClient
            ? profile.CompanyName
            : profile.Role == "Client"
                ? "Individual client"
                : "Account member";
}

<div class="profile-page py-4 py-lg-5" data-open-modal="@Model.OpenModal">
    <header class="profile-page-heading">
        <div>
            <span class="profile-eyebrow">Profile overview</span>
            <p>Your professional identity and account details in one place.</p>
        </div>
        <div class="profile-heading-actions">
            <a class="profile-back-link" asp-controller="Account" asp-action="Manage">Account settings</a>
            <a class="profile-back-link" asp-controller="Home" asp-action="Index">Back to home</a>
        </div>
    </header>

    @if (TempData["ProfileUpdateSuccess"] is string profileSuccessMessage)
    {
        <div class="alert alert-success" role="status">@profileSuccessMessage</div>
    }

    @if (TempData["ProfilePhotoSuccess"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }
    @if (TempData["ProfilePhotoError"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <section class="profile-hero">
        <div class="profile-hero-content">
            <div class="profile-avatar-wrap">
                @if (!string.IsNullOrWhiteSpace(profile.ProfileImageUrl))
                {
                    <img src="@profile.ProfileImageUrl" alt="@profile.FirstName @profile.LastName" class="profile-avatar" />
                }
                else
                {
                    <div class="profile-avatar profile-avatar-fallback" aria-label="@profile.FirstName @profile.LastName">
                        @initials
                    </div>
                }

                <form id="profile-photo-form" class="profile-photo-form" asp-controller="Profile"
                      asp-action="UpdatePhoto" method="post" enctype="multipart/form-data">
                    <input id="profile-photo-input" class="visually-hidden" type="file" name="profileImage"
                           accept="image/jpeg,image/png,image/webp,image/gif" />
                    <button id="profile-photo-button" class="profile-photo-button" type="button"
                            title="JPG, PNG, WEBP, or GIF up to 2 MB">Update photo</button>
                    <noscript>
                        <input type="file" name="profileImage" accept="image/jpeg,image/png,image/webp,image/gif"
                               required />
                        <button class="profile-photo-button" type="submit">Save photo</button>
                    </noscript>
                </form>
            </div>

            <div class="profile-identity">
                <span class="profile-role">@profile.Role account</span>
                <h1>@profile.FirstName @profile.LastName</h1>
                <p class="profile-handle">@@@profile.Username</p>

                @if (!string.IsNullOrWhiteSpace(profileSummary))
                {
                    <p class="profile-headline">@profileSummary</p>
                }
            </div>

            <div class="profile-hero-stats" aria-label="Profile summary">
                <div>
                    <strong>@ratingLabel</strong>
                    <span>Rating</span>
                </div>
                <div>
                    <strong>@profile.RatingCount</strong>
                    <span>@(profile.RatingCount == 1 ? "Review" : "Reviews")</span>
                </div>
                <div>
                    <strong>@profile.JoinedAt.ToString("yyyy")</strong>
                    <span>Joined</span>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-4 g-xl-5 mt-1 align-items-start">
        <div class="col-lg-8 col-xl-9">
            @if (profile.Role == "Freelancer")
            {
                <section class="profile-panel mb-4">
                    <div class="profile-panel-heading">
                        <div>
                            <span class="profile-kicker">Professional profile</span>
                            <h2>About my work</h2>
                        </div>

                        <div class="profile-panel-actions">
                            @if (availabilityLabel is not null)
                            {
                                <span class="availability-badge @availabilityClass">
                                    @availabilityLabel
                                </span>
                            }
                            <button type="button" class="profile-edit-trigger" data-bs-toggle="modal"
                                    data-bs-target="#edit-freelancer-profile-modal">Edit profile</button>
                        </div>
                    </div>

                    @if (string.IsNullOrWhiteSpace(profile.Bio))
                    {
                        <div class="profile-empty-state">
                            <strong>Professional bio coming soon</strong>
                            <span>This freelancer has not added a work summary yet.</span>
                        </div>
                    }
                    else
                    {
                        <p class="profile-description">@profile.Bio</p>
                    }

                    <div class="profile-facts">
                        <div class="profile-fact">
                            <span>Experience</span>
                            <strong>@(profile.ExperienceLevel?.ToString() ?? "Not specified")</strong>
                        </div>
                        <div class="profile-fact">
                            <span>Hourly rate</span>
                            <strong>@(profile.HourlyRate.HasValue ? $"${profile.HourlyRate.Value:N2} / hr" : "Not specified")</strong>
                        </div>
                        <div class="profile-fact">
                            <span>Rating</span>
                            <div class="profile-rating-row">
                                <strong>@ratingLabel</strong>
                                <small>@(hasRating ? $"out of 5 from {profile.RatingCount} reviews" : "No reviews yet")</small>
                            </div>
                        </div>
                    </div>

                </section>
            }
            else if (profile.Role == "Client")
            {
                <section class="profile-panel mb-4">
                    @if (isCompanyClient)
                    {
                        <div class="company-heading">
                            @if (!string.IsNullOrWhiteSpace(profile.CompanyLogoUrl))
                            {
                                <img src="@profile.CompanyLogoUrl" alt="@profile.CompanyName logo" class="company-logo" />
                            }
                            else
                            {
                                <div class="company-logo company-logo-fallback" aria-hidden="true">
                                    @(string.IsNullOrWhiteSpace(profile.CompanyName) ? "C" : profile.CompanyName[..1].ToUpperInvariant())
                                </div>
                            }

                            <div>
                                <span class="profile-kicker">Company client</span>
                                <h2>@profile.CompanyName</h2>
                            </div>
                            <button type="button" class="profile-edit-trigger ms-auto" data-bs-toggle="modal"
                                    data-bs-target="#edit-company-profile-modal">Edit profile</button>
                        </div>

                        <p class="profile-description">@profile.CompanyDescription</p>
                    }
                    else
                    {
                        <div class="profile-panel-heading">
                            <div>
                                <span class="profile-kicker">Client profile</span>
                                <h2>Individual client</h2>
                            </div>
                        </div>

                    }

                    <div class="profile-facts profile-facts-client">
                        <div class="profile-fact">
                            <span>Rating</span>
                            <div class="profile-rating-row">
                                <strong>@ratingLabel</strong>
                                <small>@(hasRating ? $"out of 5 from {profile.RatingCount} reviews" : "No reviews yet")</small>
                            </div>
                        </div>
                        @if (isCompanyClient)
                        {
                            <div class="profile-fact">
                                <span>Website</span>
                                @if (hasCompanyWebsite)
                                {
                                    <a href="@(companyWebsiteUri!.AbsoluteUri)" target="_blank"
                                       rel="noopener noreferrer">@(companyWebsiteUri!.Host)</a>
                                }
                                else
                                {
                                    <strong>Not specified</strong>
                                }
                            </div>
                        }
                    </div>
                </section>
            }
            else
            {
                <section class="profile-panel mb-4">
                    <span class="profile-kicker">Account profile</span>
                    <h2>@profile.FirstName @profile.LastName</h2>
                    <p class="profile-description mb-0">Role-specific profile details are not available for this account.
                    </p>
                </section>
            }
        </div>

        <div class="col-lg-4 col-xl-3 profile-sidebar">
            <aside class="profile-panel profile-contact">
                <span class="profile-kicker">Account details</span>
                <h2>Contact</h2>

                <dl>
                    <div>
                        <dt>Email</dt>
                        <dd><a href="mailto:@profile.Email">@profile.Email</a></dd>
                    </div>
                    <div>
                        <dt>Username</dt>
                        <dd>@@@profile.Username</dd>
                    </div>
                    <div>
                        <dt>Account type</dt>
                        <dd>@profile.Role</dd>
                    </div>
                    <div>
                        <dt>Member since</dt>
                        <dd><time datetime="@profile.JoinedAt.ToString("yyyy-MM-dd")">@profile.JoinedAt.ToString("MMMM yyyy")</time></dd>
                    </div>
                </dl>

                <a class="profile-contact-button" href="mailto:@profile.Email">Email @profile.FirstName</a>

                @if (hasPortfolioUrl)
                {
                    <a class="profile-secondary-link" href="@(portfolioUri!.AbsoluteUri)" target="_blank"
                       rel="noopener noreferrer">External portfolio</a>
                }
                else if (isCompanyClient && hasCompanyWebsite)
                {
                    <a class="profile-secondary-link" href="@(companyWebsiteUri!.AbsoluteUri)" target="_blank"
                       rel="noopener noreferrer">Company website</a>
                }
            </aside>
        </div>
    </div>
</div>

@if (Model.CompanyEditor is not null)
{
    <partial name="_EditCompanyProfileModal" for="CompanyEditor" />
}

@if (Model.FreelancerEditor is not null)
{
    <partial name="_EditFreelancerProfileModal" for="FreelancerEditor" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const page = document.querySelector(".profile-page");
            const form = document.getElementById("profile-photo-form");
            const input = document.getElementById("profile-photo-input");
            const button = document.getElementById("profile-photo-button");

            if (form && input && button) {
                button.addEventListener("click", () => input.click());
                input.addEventListener("change", () => {
                    if (input.files.length > 0) {
                        form.requestSubmit();
                    }
                });
            }

            const modalId = page?.dataset.openModal;
            if (modalId) {
                const modalElement = document.getElementById(modalId);
                if (modalElement) {
                    modalElement.addEventListener("shown.bs.modal", () => {
                        modalElement.querySelector(".input-validation-error, input, select, textarea")?.focus();
                    }, { once: true });
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                }
            }
        })();
    </script>
}
