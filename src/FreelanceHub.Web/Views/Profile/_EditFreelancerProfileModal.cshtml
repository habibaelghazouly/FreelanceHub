@model EditFreelancerProfileViewModel

<div class="modal fade" id="edit-freelancer-profile-modal" tabindex="-1" aria-labelledby="edit-freelancer-profile-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content profile-edit-modal profile-page">
            <form asp-controller="Profile" asp-action="UpdateFreelancerProfile" method="post">
                <div class="modal-header">
                    <div>
                        <span class="profile-kicker">Professional profile</span>
                        <h2 class="modal-title" id="edit-freelancer-profile-title">Edit freelancer details</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="ProfessionalTitle" class="form-label"></label>
                        <input asp-for="ProfessionalTitle" class="form-control" />
                        <span asp-validation-for="ProfessionalTitle" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HourlyRate" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="HourlyRate" class="form-control" step="0.01" />
                            </div>
                            <span asp-validation-for="HourlyRate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ExperienceLevel" class="form-label"></label>
                            <select asp-for="ExperienceLevel" asp-items="Html.GetEnumSelectList<FreelancerExperienceLevel>()" class="form-select">
                                <option value="">Select level</option>
                            </select>
                            <span asp-validation-for="ExperienceLevel" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AvailabilityStatus" class="form-label"></label>
                        <select asp-for="AvailabilityStatus" asp-items="Html.GetEnumSelectList<FreelancerAvailabilityStatus>()" class="form-select">
                            <option value="">Select status</option>
                        </select>
                        <span asp-validation-for="AvailabilityStatus" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ExternalPortfolioUrl" class="form-label"></label>
                        <input asp-for="ExternalPortfolioUrl" class="form-control" type="url" placeholder="https://portfolio.example.com" />
                        <span asp-validation-for="ExternalPortfolioUrl" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Bio" class="form-label"></label>
                        <textarea asp-for="Bio" class="form-control" rows="7"></textarea>
                        <div class="form-text">20 to 2000 characters.</div>
                        <span asp-validation-for="Bio" class="text-danger"></span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark">Save freelancer profile</button>
                </div>
            </form>
        </div>
    </div>
</div>
